{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/export-envelope.schema.json",
  "title": "South Andrews structured export envelope",
  "type": "object",
  "required": [
    "schema_version",
    "generated_date",
    "source_of_truth",
    "document_status",
    "provenance",
    "validation_result",
    "unresolved_dependencies"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_date": {"type": "string", "format": "date"},
    "source_of_truth": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "document_status": {"enum": ["current", "ratified", "draft", "superseded", "archived"]},
    "provenance": {"type": "string", "minLength": 1},
    "validation_result": {
      "type": "object",
      "required": ["status", "checked_at"],
      "properties": {
        "status": {"enum": ["not_run", "passed", "failed"]},
        "checked_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "unresolved_dependencies": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
