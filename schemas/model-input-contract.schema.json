{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/model-input-contract.schema.json",
  "title": "Future model input contract",
  "type": "object",
  "required": ["schema_version", "model_status", "inputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_status": {"enum": ["template", "working", "owner_reviewed", "superseded"]},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "category",
          "value",
          "unit",
          "provenance",
          "status",
          "scenario_association",
          "owner_decision_requirement",
          "external_use_status"
        ],
        "properties": {
          "input_id": {"type": "string", "pattern": "^MI-[0-9]{3}$"},
          "category": {
            "enum": [
              "land_basis",
              "building_program",
              "floor_plate",
              "parking_count",
              "office_clinical_rent",
              "retail_rent",
              "occupancy",
              "development_costs",
              "contingency",
              "financing",
              "tax_credit_treatment",
              "grants",
              "partner_support",
              "charger_economics",
              "av_revenue",
              "exit_cap",
              "hurdle_rate"
            ]
          },
          "value": {},
          "unit": {"type": ["string", "null"]},
          "provenance": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["ratified", "working_assumption", "scenario", "unresolved", "not_applicable"]},
          "scenario_association": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "owner_decision_requirement": {"type": ["string", "null"]},
          "external_use_status": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  }
}
