{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/statement.schema.json",
  "title": "Material statement",
  "type": "object",
  "required": [
    "statement_id",
    "statement_text",
    "statement_type",
    "evidence_class",
    "status",
    "provenance",
    "source_location",
    "confidence",
    "external_use_status",
    "date_last_reviewed",
    "dependencies",
    "supersession"
  ],
  "properties": {
    "statement_id": {"type": "string", "pattern": "^(CAN|CLM)-[0-9]{3}$"},
    "statement_text": {"type": "string", "minLength": 1},
    "statement_type": {
      "enum": [
        "verified_fact",
        "corroborated_fact",
        "source_derived_claim",
        "model_output",
        "owner_decision",
        "adopted_strategy",
        "working_assumption",
        "scenario",
        "recommendation",
        "historical_claim",
        "rejected_scenario",
        "unresolved",
        "missing_source_dependency"
      ]
    },
    "evidence_class": {
      "enum": [
        "verified_fact",
        "source_derived_but_not_independently_verified",
        "current_working_assumption",
        "model_output",
        "recommendation",
        "open_question",
        "superseded_assumption",
        "rejected_scenario"
      ]
    },
    "status": {"type": "string"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_location": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "required": ["level", "basis"],
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "external_use_status": {
      "enum": ["internal_only", "external_eligible", "approved_with_caveat", "blocked_pending_resolution"]
    },
    "date_last_reviewed": {"type": "string", "format": "date"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "supersession": {
      "type": "object",
      "required": ["supersedes", "superseded_by"],
      "properties": {
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "superseded_by": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": true
}
